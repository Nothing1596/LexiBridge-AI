# LexiBridge AI Environment Variables Example
# Copy this file to .env and fill in real values when needed.
# Do not commit the real .env file to Git.

# ------------------------------------------------------------
# Flask basic settings
# ------------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=True

# Change this in production.
SECRET_KEY=change-this-secret-key-before-deployment

# ------------------------------------------------------------
# Backend server
# ------------------------------------------------------------

BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# Local API base URL used during development.
API_BASE_URL=http://127.0.0.1:5000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Current local MVP uses SQLite.
# Example:
DATABASE_URL=sqlite:///lexibridge.db

# Future production example:
# DATABASE_URL=postgresql://username:password@host:5432/lexibridge

# ------------------------------------------------------------
# File upload settings
# ------------------------------------------------------------

UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=50

# Allowed upload formats:
ALLOWED_EXTENSIONS=pdf,docx,pptx

# ------------------------------------------------------------
# Knowledge base settings
# ------------------------------------------------------------

KNOWLEDGE_CHUNK_MAX_CHARS=700
KNOWLEDGE_CHUNK_OVERLAP=80

# Future vector search settings:
VECTOR_SEARCH_ENABLED=False
VECTOR_DB_PROVIDER=none

# Possible future values:
# VECTOR_DB_PROVIDER=faiss
# VECTOR_DB_PROVIDER=chroma
# VECTOR_DB_PROVIDER=pgvector

# ------------------------------------------------------------
# AI provider settings
# ------------------------------------------------------------

AI_PROVIDER=none

# Possible future values:
# AI_PROVIDER=deepseek
# AI_PROVIDER=openai
# AI_PROVIDER=gemini
# AI_PROVIDER=local

# DeepSeek example:
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI example:
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini

# Gemini example:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------
# CORS settings
# ------------------------------------------------------------

# Local frontend file or future deployed frontend domain.
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Future production example:
# FRONTEND_ORIGIN=https://your-domain.com

# ------------------------------------------------------------
# Security notes
# ------------------------------------------------------------

# Never put real API keys into .env.example.
# Use .env for real local secrets.
# The .env file should be ignored by Git.
